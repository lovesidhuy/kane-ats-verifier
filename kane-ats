#!/usr/bin/env python3
"""Executable launcher for kane-ats CLI."""
import os
import sys
from pathlib import Path

# Auto re-exec with modern Python 3.10+ if invoked with legacy system Python or Python missing dependencies
needs_reexec = sys.version_info < (3, 10)
if not needs_reexec:
    try:
        import pytest, flask, yaml
    except ImportError:
        needs_reexec = True

if needs_reexec:
    for cand in [
        "/opt/homebrew/bin/python3.14",
        "/opt/homebrew/opt/python@3.14/bin/python3.14",
        "/opt/homebrew/bin/python3.12",
        "/opt/homebrew/bin/python3.11",
        "/usr/local/bin/python3",
    ]:
        if os.path.exists(cand) and cand != sys.executable:
            os.execv(cand, [cand] + sys.argv)

# Ensure repo root is on sys.path
REPO_ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(REPO_ROOT))

from ats_verifier.cli import main

if __name__ == "__main__":
    sys.exit(main())
